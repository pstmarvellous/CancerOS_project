# Development placeholders only. scripts/local_postgres.py generates ignored local values.
MODE=development
DATABASE_URL=postgresql+psycopg://CHANGE_ME:CHANGE_ME@127.0.0.1:55432/canceros_dev
TEST_DATABASE_URL=postgresql+psycopg://CHANGE_ME:CHANGE_ME@127.0.0.1:55432/canceros_disposable_test
LOCAL_POSTGRES_PASSWORD=CHANGE_ME
QUEUE_URL=redis://:CHANGE_ME@127.0.0.1:56379/0
STORAGE_ENDPOINT=http://127.0.0.1:58333
STORAGE_BUCKET=canceros-private
STORAGE_ACCESS_KEY=CHANGE_ME
STORAGE_SECRET_KEY=CHANGE_ME
MONITOR_TOKEN=CHANGE_ME
IDENTITY_ISSUER=canceros-local
IDENTITY_AUDIENCE=canceros-api
# Trusted RSA public key file; no private signing key is needed by API/workers.
IDENTITY_PUBLIC_KEY_FILE=
CORS_ORIGINS=["http://127.0.0.1:3000"]
EXTERNAL_INFERENCE_ENABLED=false
MODEL_PROVIDER=meta
MODEL_IDENTIFIER=muse-spark-1.3
MODEL_API_KEY=
EXPORT_POLICY_PATH=
REQUEST_LIMIT_BYTES=1048576
ARTIFACT_LIMIT_BYTES=1048576
JOB_MAX_ATTEMPTS=3
DEPENDENCY_TIMEOUT_SECONDS=3
