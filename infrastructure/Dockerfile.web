# Pinned reproducible web image; no secrets, patient payloads or analytics keys.
# Build: docker build -f infrastructure/Dockerfile.web -t canceros-web:<digest> .
# Run: compose profile `staging` with a private .env.staging (never committed).

FROM node:22.17.0-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/web/package.json ./apps/web/package.json
COPY packages/contracts/package.json ./packages/contracts/package.json
RUN npm ci --ignore-scripts
COPY . .
RUN npm run build --workspace @canceros/web

FROM node:22.17.0-alpine AS runtime
ENV NODE_ENV=production
RUN adduser -D -u 10001 canceros
USER canceros
WORKDIR /app
COPY --from=build --chown=canceros:canceros /app/apps/web/.next/standalone ./
COPY --from=build --chown=canceros:canceros /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=canceros:canceros /app/apps/web/public ./apps/web/public
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget -qO- http://127.0.0.1:3000/api/health || exit 1
EXPOSE 3000
ENTRYPOINT ["node", "apps/web/server.js"]
