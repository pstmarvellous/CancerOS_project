        },
        "visit_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Visit Id"
        }
      },
      "required": [
        "client_record_key",
        "source_locator_id",
        "time",
        "original_term",
        "certainty",
        "negation",
        "kind",
        "concept",
        "presence",
        "reporter"
      ],
      "title": "SymptomInput",
      "type": "object"
    },
    "TimestampTime": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "const": "timestamp",
          "title": "Basis",
          "type": "string"
        },
        "time_domain": {
          "enum": [
            "source_calendar",
            "source_shifted",
