          "title": "Time Domain",
          "type": "string"
        },
        "timeline_origin_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeline Origin Id"
        },
        "value": {
          "pattern": "^-?(0|[1-9]\\d*)(\\.\\d{1,9})?$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "basis",
        "value",
        "time_domain"
      ],
      "title": "RelativeTime",
      "type": "object"
    },
    "SourceReferenceInterval": {
      "additionalProperties": false,
      "properties": {
        "high": {
          "anyOf": [
            {
              "pattern": "^-?(0|[1-9]\\d*)(\\.\\d{1,9})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "High"
        },
        "low": {
          "anyOf": [
            {
              "pattern": "^-?(0|[1-9]\\d*)(\\.\\d{1,9})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Low"
        },
        "population_context": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Population Context",
          "type": "string"
        },
        "source_description": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Source Description",
          "type": "string"
        },
        "unit": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "version": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "unit",
        "source_description",
        "population_context",
        "version"
      ],
      "title": "SourceReferenceInterval",
      "type": "object"
    },
